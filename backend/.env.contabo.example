ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@database-host:5432/fms?sslmode=require
AUTO_RUN_SCHEMA_MIGRATIONS=false

ENFORCE_AUTH=true
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=542183516756-0k3us1g6i9b9oetl1g5g03pvkkasm652.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=542183516756-ldm6gdss7er9unmai4gdd0cbft8shqm1.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=com.quantech.smeexchange
APPLE_REDIRECT_URI=https://smeexchange.vercel.app/api/auth/apple/callback
APPLE_ANDROID_REDIRECT_URI=smeexchange://apple-callback
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

FRONTEND_ORIGINS=https://smeexchange.vercel.app,https://smeexchange.org
FRONTEND_ORIGIN_REGEX=^https://smeexchange(?:-[a-z0-9-]+)?(?:-jdionedas-projects)?\.vercel\.app$

ENABLE_RATE_LIMIT=true
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0
ENABLE_API_DOCS=false

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
AI_PROVIDER_MODE=openai
SENTRY_DSN=